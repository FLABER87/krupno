<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The only third-party runtime dependency: Windows ML, which brings ONNX Runtime (with its .NET API), DirectML, and on
         Windows 11 24H2+ the catalog of the GPU and NPU vendors' execution providers. Microsoft.ML.OnnxRuntime.DirectML
         stopped at 1.24.4. -->
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unit tests only (tests/Krupno.Core.Tests). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
