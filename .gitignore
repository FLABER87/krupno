# .NET
bin/
obj/
# Installer build output (installer/build.ps1).
artifacts/
.vs/
*.user
*.suo

# Python
__pycache__/
.venv/
venv/

# Models and weights are large and carry their own licenses: never commit them, whatever folder they are in.
*.onnx
*.pth
*.safetensors
*.ckpt

# Exception: synthetic test models of a few hundred bytes each (written by tests/make_fixtures.py --models).
!tests/fixtures/models/*.onnx

# Tests: images are generated by tests/make_fixtures.py, run results go to tests/out.
tests/fixtures/images/
tests/fixtures/broken/
tests/fixtures/color/
tests/out/
