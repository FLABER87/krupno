<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flat win-x64 output: onnxruntime.dll and DirectML.dll sit next to the exe,
         so an outdated DirectML.dll from System32 is never picked up. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.1.0</Version>
    <Product>Krupno</Product>
    <!-- The languages the window is translated into (src/Krupno.App/Infrastructure/UiLanguage.cs): the self-contained
         publish takes WPF's own translations for them (the text box menu, for example) and leaves out the rest. -->
    <SatelliteResourceLanguages>en;uk;ru;pl;de;fr;it;es;pt-BR;tr;id;vi;ja;ko;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
