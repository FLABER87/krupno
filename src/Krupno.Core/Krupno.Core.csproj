<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF is only needed for the WIC codecs (System.Windows.Media.Imaging). -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Krupno.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF turns off the implicit using System.IO (Path name conflict). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Krupno.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Progress messages and errors that reach the user, in English and the translations (see Krupno.App's Strings.resx). -->
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
