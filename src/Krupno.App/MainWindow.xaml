<Window x:Class="Krupno.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Krupno.App.Controls"
        Title="{Binding WindowTitle}"
        Icon="Assets/Krupno.ico"
        Width="1360" Height="880" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave" PreviewDrop="OnPreviewDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding UpscaleCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="348" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Canvas: preview, empty state, batch filmstrip ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CompareView x:Name="Compare" BeforeSource="{Binding Before}" AfterSource="{Binding After}"
                                  Tiles="{Binding Tiles}" />

            <!-- Empty window -->
            <Grid Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibility}}" Margin="48">
                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="28"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Drag photos or a folder here" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="14"
                               Text="A neural network enlarges the image 2–8 times and fills in the details. You can add several files at once; they are processed one after another." />
                    <Button Command="{Binding OpenCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" Margin="0,0,8,0" />
                            <TextBlock Text="Select files" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="PNG, JPEG, TIFF, BMP, GIF, WebP, HEIC · Ctrl+O" />
                </StackPanel>
            </Grid>

            <!-- The file didn't open -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding PreviewError, Converter={StaticResource NullToCollapsed}}">
                <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="24"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Border>
                <TextBlock Text="Can't open this file" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding PreviewError}" TextAlignment="Center" FontSize="13" />
                <Button Command="{Binding OpenCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,6">
                    <TextBlock Text="Select another file" />
                </Button>
            </StackPanel>

            <!-- Highlight while dragging over -->
            <Grid Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" Margin="16">
                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5 4"
                           Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                           Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Border Style="{StaticResource FloatingPanel}" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Drop to open" FontSize="14" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Toast notification -->
            <Border Style="{StaticResource FloatingPanel}" Padding="14,8" Margin="0,20,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                    Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0" FontSize="14"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Toast}" />
                </StackPanel>
            </Border>

            <!-- Batch filmstrip -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="16,10"
                    Visibility="{Binding HasMultipleFiles, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding AddFilesCommand}" ToolTip="Add files" AutomationProperties.Name="Add files">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding ClearFilesCommand}" ToolTip="Clear list" AutomationProperties.Name="Clear list">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding CurrentFile}"
                             ItemContainerStyle="{StaticResource FilmstripItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="92">
                                    <Grid Height="62">
                                        <Border CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <!-- Status: processing / done / error -->
                                        <Border Width="20" Height="20" CornerRadius="10" Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="11"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="10" Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="10" Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource SystemFillColorCriticalBrush}"
                                                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="11" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Settings panel ═══ -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>

                <!-- Bottom of the panel: action, progress, result or error -->
                <Border DockPanel.Dock="Bottom" Padding="20,16,20,18" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <!-- Empty -->
                        <StackPanel Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding PrimaryCommand}"
                                    HorizontalAlignment="Stretch" Height="40" FontSize="15">
                                <TextBlock Text="Select files" />
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" Text="Ctrl+O" />
                        </StackPanel>

                        <!-- Ready to start -->
                        <StackPanel Visibility="{Binding IsReadyState, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Notice}" Margin="0,0,0,10"
                                       Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding PrimaryCommand}"
                                    HorizontalAlignment="Stretch" Height="40" FontSize="15">
                                <TextBlock Text="{Binding UpscaleButtonText}" />
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Enter" />
                        </StackPanel>

                        <!-- Processing -->
                        <Border Style="{StaticResource StatusCard}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{Binding IsBusyState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding EtaText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProgressTitle}" FontWeight="SemiBold" FontSize="14" />
                                </DockPanel>
                                <ProgressBar Margin="0,10,0,10" Height="4" Minimum="0" Maximum="1"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Padding="12,4" Margin="8,0,0,0"
                                            ToolTip="Stop (Esc)">
                                        <TextBlock Text="Cancel" />
                                    </Button>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressDetail}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressNote}" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="{Binding ProgressNote, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <!-- Result -->
                        <StackPanel Visibility="{Binding IsDoneState, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource StatusCard}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="20" Margin="0,0,10,0"
                                               VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DoneTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DoneSubtitle}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DoneSubtitle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Command="{Binding OpenResultCommand}" Margin="0,0,5,0" HorizontalAlignment="Stretch" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,8,0" FontSize="14" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowInFolderCommand}" Margin="5,0,0,0" HorizontalAlignment="Stretch" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" Margin="0,0,8,0" FontSize="14" />
                                        <TextBlock Text="Show in folder" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}" Text="Ctrl+C — copy the result" />
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel Visibility="{Binding IsErrorState, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource StatusCard}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    ToolTip="{Binding ErrorTechnical}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="20" Margin="0,0,10,0"
                                               VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="Upscaling failed" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ErrorDetail}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding UpscaleCommand}"
                                    HorizontalAlignment="Stretch" Height="40" FontSize="15" Margin="0,10,0,0">
                                <TextBlock Text="Try again" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20,14,20,10" IsEnabled="{Binding IsIdle}">

                        <!-- Model -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshModelsCommand}"
                                        ToolTip="Refresh model list" AutomationProperties.Name="Refresh model list"
                                        MinWidth="26" MinHeight="26" Padding="4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenModelsFolderCommand}"
                                        ToolTip="Open models folder" AutomationProperties.Name="Open models folder"
                                        MinWidth="26" MinHeight="26" Padding="4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" FontSize="13" />
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Model" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVisibility}}"
                                   Text="No models yet. Put .onnx files in the models folder and click &quot;Refresh&quot;." />

                        <ListBox Template="{StaticResource PlainListBox}" ItemsSource="{Binding VisibleModels}"
                                 SelectedItem="{Binding SelectedModel}" ItemContainerStyle="{StaticResource ModelCard}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    ToolTip="CC BY-NC-SA license: non-commercial use only"
                                                    Visibility="{Binding IsNonCommercial, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource LinkButton}" Command="{Binding ToggleAllModelsCommand}" Margin="2,2,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasMoreModels, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding AllModelsToggleText}" />
                        </Button>

                        <!-- Scale -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Scale" Margin="0,16,0,8" />
                        <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Scales}"
                                 SelectedItem="{Binding SelectedScale}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SizePreview}" Margin="2,6,0,0" />

                        <!-- Saving -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Save as" Margin="0,16,0,8" />
                        <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}"
                                 SelectedItem="{Binding SelectedFormat}" />
                        <DockPanel Margin="2,10,0,0" Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="Quality" Width="64" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding JpegQuality}" Width="28" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12" />
                            <Slider Minimum="60" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding JpegQuality}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xF12B;" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,8,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Command="{Binding BrowseOutputCommand}" VerticalAlignment="Center">
                                    <TextBlock Text="Change" />
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding ResetOutputCommand}" Margin="4,0,0,0"
                                        MinWidth="22" MinHeight="22" Padding="3" ToolTip="Save next to the original"
                                        AutomationProperties.Name="Save next to the original"
                                        Visibility="{Binding HasCustomOutputFolder, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding OutputFolderDisplay}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding OutputFolderDisplay}" />
                        </DockPanel>

                        <!-- Advanced -->
                        <Expander Margin="0,16,0,0" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding AdvancedSummary}"
                                               VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Advanced" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="Device" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Caption}" Text="Tile size" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding TileSizes}" SelectedItem="{Binding SelectedTile}"
                                          DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="Smaller tiles use less video memory. If memory runs out, the tile size is reduced automatically." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
