<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Krupno</AssemblyName>
    <RootNamespace>Krupno.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main hands files to a window that is already open before WPF starts (Infrastructure/SingleInstance.cs). -->
    <StartupObject>Krupno.App.Program</StartupObject>
    <!-- The icon is generated by tools/make_icon.py. -->
    <ApplicationIcon>Assets\Krupno.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent) is still marked as experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Krupno.Core\Krupno.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Krupno.ico" />
  </ItemGroup>

</Project>
