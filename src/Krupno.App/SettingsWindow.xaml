<Window x:Class="Krupno.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Krupno.App.Properties"
        Title="{x:Static p:Strings.Section_Settings}"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <!-- The settings that are set once and rarely touched; the window's DataContext is the main window's view model, so a
         choice applies at once, and there is nothing to confirm. Compact enough to fit a laptop at 200% scaling (about 690
         logical pixels of height) without scrolling: the labels stand beside the lists. -->
    <Window.Resources>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,10,24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Button IsCancel="True" HorizontalAlignment="Right" MinWidth="110" Padding="16,6">
                <TextBlock Text="{x:Static p:Strings.Close}" />
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,14,24,16" Grid.IsSharedSizeScope="True">

                <!-- Processing -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static p:Strings.Settings_Processing}" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Device}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{x:Static p:Strings.Device}" />
                        </Grid>
                        <!-- The vendors' accelerators Windows ML can add for this computer (Windows 11 24H2+). -->
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding HasAcceleratorOffer, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{x:Static p:Strings.Accelerators_ToolTip}">
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding AcceleratorOffer}"
                                       Visibility="{Binding AcceleratorOffer, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding AcceleratorStatus}"
                                       Visibility="{Binding AcceleratorStatus, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{StaticResource LinkButton}" Command="{Binding InstallAcceleratorsCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="{x:Static p:Strings.Accelerators_Download}" />
                            </Button>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.TileSize}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TileSizes}" SelectedItem="{Binding SelectedTile}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{x:Static p:Strings.TileSize}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="{x:Static p:Strings.TileSize_Description}" />
                        <CheckBox Content="{x:Static p:Strings.SeamlessTiles}" IsChecked="{Binding SeamlessTiles}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{x:Static p:Strings.SeamlessTiles_Description}" />
                        <CheckBox Content="{x:Static p:Strings.Tta}" IsChecked="{Binding TestTimeAugmentation}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{x:Static p:Strings.Tta_Description}" />
                    </StackPanel>
                </Border>

                <!-- General: the language and the update check -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static p:Strings.Settings_General}" Margin="0,16,0,0" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{x:Static p:Strings.Language}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{x:Static p:Strings.Language}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{x:Static p:Strings.Language_Restart}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel Margin="0,12,0,0">
                            <!-- The version that is running: what "Update" would replace. -->
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding VersionText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <CheckBox Content="{x:Static p:Strings.CheckForUpdates}" IsChecked="{Binding CheckForUpdates}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{x:Static p:Strings.CheckForUpdates_Description}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
