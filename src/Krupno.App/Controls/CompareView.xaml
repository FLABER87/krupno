<UserControl x:Class="Krupno.App.Controls.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="SubtleToggle" TargetType="RadioButton" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" ClipToBounds="True"
          MouseLeftButtonDown="OnLeftDown" MouseLeftButtonUp="OnButtonUp"
          MouseRightButtonDown="OnPanDown" MouseRightButtonUp="OnButtonUp"
          MouseDown="OnMouseDown" MouseUp="OnMouseUp"
          MouseMove="OnMouseMove" MouseWheel="OnMouseWheel" MouseLeave="OnMouseLeave">

        <!-- Stage with the images; room at the bottom for the floating zoom toolbar. -->
        <Grid x:Name="Stage" Margin="24,24,24,72" SizeChanged="OnStageSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <ColumnDefinition x:Name="GapColumn" Width="0" />
                <ColumnDefinition x:Name="RightColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="BeforeLayer" ClipToBounds="True">
                <Viewbox x:Name="BeforeBox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                         SizeChanged="OnBoxSizeChanged">
                    <Grid x:Name="BeforeContent">
                        <Image x:Name="BeforeImage" Stretch="Fill" />
                        <Path x:Name="TileShade" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Path x:Name="TileOutline" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                              IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Viewbox>
            </Grid>

            <Grid x:Name="AfterLayer" ClipToBounds="True" Visibility="Collapsed">
                <Viewbox x:Name="AfterBox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                         SizeChanged="OnBoxSizeChanged">
                    <Image x:Name="AfterImage" Stretch="Fill" />
                </Viewbox>
            </Grid>

            <Grid x:Name="Divider" Width="28" HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle Width="2" Fill="White" HorizontalAlignment="Center" />
                <Border Width="28" Height="28" CornerRadius="14" Background="White" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="13" Foreground="#FF3A3A3A" />
                </Border>
            </Grid>

            <Border x:Name="BeforeChip" Style="{StaticResource PhotoChip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="BeforeChipText" />
            </Border>
            <Border x:Name="AfterChip" Style="{StaticResource PhotoChip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="AfterChipText" />
            </Border>
        </Grid>

        <!-- Floating toolbar for zoom and comparison mode. -->
        <Border x:Name="Toolbar" Style="{StaticResource FloatingPanel}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButton}" Click="OnZoomOutClick" ToolTip="Zoom out (Ctrl + −)" AutomationProperties.Name="Zoom out">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" />
                </Button>
                <TextBlock x:Name="ZoomText" Width="50" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Button Style="{StaticResource SubtleButton}" Click="OnZoomInClick" ToolTip="Zoom in (Ctrl + +)" AutomationProperties.Name="Zoom in">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource SubtleButton}" Click="OnFitClick" ToolTip="Fit to window (Ctrl + 0)" AutomationProperties.Name="Fit to window">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" />
                </Button>
                <Button Style="{StaticResource SubtleButton}" Click="OnActualSizeClick" ToolTip="Actual pixels (Ctrl + 1)" AutomationProperties.Name="Actual size">
                    <TextBlock Text="1:1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
                <Rectangle x:Name="ModeDivider" Style="{StaticResource ToolbarDivider}" />
                <StackPanel x:Name="ModeButtons" Orientation="Horizontal">
                    <RadioButton x:Name="SplitModeButton" Style="{StaticResource SubtleToggle}" GroupName="CompareMode"
                                 IsChecked="True" Checked="OnModeChecked" ToolTip="Split view: drag the divider">
                        <TextBlock Text="Split" />
                    </RadioButton>
                    <RadioButton x:Name="SideModeButton" Style="{StaticResource SubtleToggle}" GroupName="CompareMode"
                                 Checked="OnModeChecked" ToolTip="Original and result side by side">
                        <TextBlock Text="Side by side" />
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
